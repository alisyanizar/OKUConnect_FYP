    {
      "parameters": {
        "jsCode": "// Builds a readable admin summary: counts, then changed pages grouped by topic with clickable titles.\nconst s = $('Weekly summary').first().json;\nconst pages = $('Changed pages').all().map((i) => i.json).filter((p) => p.url);\nconst checked = Number(s.checked) || 0;\nconst changed = Number(s.changed) || 0;\nconst esc = (v) => String(v || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst TOPICS = {\n  'mengesahkan-status-oku': '🪪 Status & registration',\n  'panduan-penjagaan-dan-bantuan-kesihatan-oku': '🩺 Health & care',\n  'institusi-kebajikan-dan-program-oku': '🏠 Welfare institutions',\n  'mendapatkan-bantuan-pendidikan-oku': '🎓 Education',\n  'mendapatkan-bantuan-pekerjaan-oku': '💼 Employment',\n  'mobiliti-dan-kemudahan-oku-untuk-bergerak': '♿ Mobility & facilities',\n};\n\nconst when = $now.setZone('Asia/Kuala_Lumpur').toFormat('d LLL yyyy, h:mm a');\nlet text = `📋 <b>Weekly knowledge base check</b>\\n🗓 ${when}\\n\\n`;\ntext += `✅ ${checked} pages checked\\n🔄 ${changed} updated  ·  ⏸ ${Math.max(checked - changed, 0)} unchanged`;\n\nif (changed === 0) {\n  text += '\\n\\nNo changes this week. The knowledge base is up to date.';\n} else {\n  if (checked > 0 && changed === checked) {\n    text += '\\n\\nℹ️ <i>Every page was re-processed. This is normal on the first run, or if the website changed its layout.</i>';\n  }\n  const groups = {};\n  for (const p of pages) {\n    const slug = (p.url.split('/oku/')[1] || '').split('/')[0];\n    const name = TOPICS[slug] || '📄 Other';\n    (groups[name] = groups[name] || []).push(`<a href=\"${esc(p.url)}\">${esc(p.title || 'Page')}</a>`);\n  }\n  text += '\\n\\n<b>Updated pages</b>';\n  for (const [name, links] of Object.entries(groups)) {\n    text += `\\n\\n<b>${esc(name)}</b> (${links.length})\\n${links.join(' · ')}`;\n  }\n}\n\nreturn [{ json: { payload: { chat_id: $('Page details').first().json.admin_chat_id, text, parse_mode: 'HTML', disable_web_page_preview: true } } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
