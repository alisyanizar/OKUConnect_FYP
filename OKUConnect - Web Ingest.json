    {
      "parameters": {
        "jsCode": "// Builds the weekly \"Scheme of the week\" message for each subscriber in their language.\nconst picks = $('Pick spotlight').all().map((i) => i.json);\nconst answers = $input.all().map((i) => i.json);\nconst subs = $('Get subscribers').all().map((i) => i.json).filter((s) => s.chat_id);\n\nconst esc = (s) => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst fmt = (a) => esc(a)\n  .replace(/\\[([^\\]]+)\\]\\((https?:\\/\\/[^\\s)]+)\\)/g, '<a href=\"$2\">$1</a>')\n  .replace(/\\*\\*(.+?)\\*\\*/g, '<b>$1</b>')\n  .replace(/^#{1,6}\\s*(.+)$/gm, '<b>$1</b>')\n  .replace(/^\\s*[-*]\\s+/gm, '• ');\n\nconst T = {\n  en: { head: '📢 <b>OKUConnect weekly update</b>', spot: '💡 <b>Scheme of the week:</b> ', fail: 'This week\\'s spotlight is not available. Tap the menu to explore topics.', note: 'ℹ️ Always confirm important details with the agency.', more: '📚 Related questions', menu: '🏠 Main menu', stop: '🔕 Stop weekly updates' },\n  ms: { head: '📢 <b>Kemas kini mingguan OKUConnect</b>', spot: '💡 <b>Skim minggu ini:</b> ', fail: 'Sorotan minggu ini tidak tersedia. Tekan menu untuk meneroka topik.', note: 'ℹ️ Sentiasa sahkan butiran penting dengan agensi.', more: '📚 Soalan berkaitan', menu: '🏠 Menu utama', stop: '🔕 Hentikan kemas kini mingguan' },\n};\n\nconst byLang = {};\npicks.forEach((p, i) => {\n  const out = answers[i] && typeof answers[i].output === 'string' ? answers[i].output.trim() : '';\n  byLang[p.lang] = { ...p, answer: out };\n});\n\nreturn subs.map((s) => {\n  const L = s.lang === 'en' ? 'en' : 'ms';\n  const t = T[L];\n  const p = byLang[L] || {};\n  let text = `${t.head}\\n\\n${t.spot}${esc((p.scheme || '').replace(/^./, (c) => c.toUpperCase()))}\\n\\n`;\n  text += p.answer ? fmt(p.answer) : t.fail;\n  text += `\\n\\n${t.note}`;\n  if (text.length > 4000) text = text.slice(0, 3990) + '…';\n  const kb = [];\n  if (p.topic) kb.push([{ text: t.more, callback_data: `n:t:${p.topic}` }]);\n  kb.push([{ text: t.menu, callback_data: 'n:home' }], [{ text: t.stop, callback_data: 'n:unsub' }]);\n  return { json: { payload: { chat_id: s.chat_id, text, parse_mode: 'HTML', disable_web_page_preview: true, reply_markup: { inline_keyboard: kb } } } };\n});\n"
      },
