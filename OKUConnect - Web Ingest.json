    {
      "parameters": {
        "jsCode": "// Picks this week's scheme (rotates weekly) and prepares one RAG question per subscriber language.\nconst subs = $input.all().map((i) => i.json).filter((s) => s.chat_id);\nif (!subs.length) return [];\n\nconst SCHEMES = [\n  { topic: 'kad', en: 'Kad OKU and OKU registration with JKM', ms: 'Kad OKU dan pendaftaran OKU dengan JKM' },\n  { topic: 'kerja', en: 'Elaun Pekerja OKU (EPOKU)', ms: 'Elaun Pekerja OKU (EPOKU)' },\n  { topic: 'pks', en: 'the PERKESO Invalidity Pension', ms: 'Pencen Ilat PERKESO' },\n  { topic: 'jkm', en: 'Bantuan Alat Sokongan / Alat Tiruan (BAT)', ms: 'Bantuan Alat Sokongan / Alat Tiruan (BAT)' },\n  { topic: 'kerja', en: 'the Job Coach programme', ms: 'program Job Coach' },\n  { topic: 'jkm', en: 'Bantuan Penjagaan OKU Terlantar (BPT)', ms: 'Bantuan Penjagaan OKU Terlantar (BPT)' },\n  { topic: 'edu', en: 'Taska OKU and special education schools', ms: 'Taska OKU dan sekolah pendidikan khas' },\n  { topic: 'kerja', en: 'Bantuan OKU Tidak Berupaya Bekerja (BTB)', ms: 'Bantuan OKU Tidak Berupaya Bekerja (BTB)' },\n  { topic: 'agensi', en: 'Program Pemulihan Dalam Komuniti (PDK)', ms: 'Program Pemulihan Dalam Komuniti (PDK)' },\n  { topic: 'kerja', en: 'Bengkel Daya for OKU', ms: 'Bengkel Daya untuk OKU' },\n  { topic: 'agensi', en: 'Independent Living Centres (ILC) for OKU', ms: 'Pusat Kehidupan Berdikari (ILC) untuk OKU' },\n  { topic: 'hak', en: 'public transport facilities and discounts for OKU', ms: 'kemudahan dan diskaun pengangkutan awam untuk OKU' },\n  { topic: 'kwsp', en: 'KWSP withdrawal for members with a disability', ms: 'pengeluaran KWSP bagi ahli yang hilang upaya' },\n  { topic: 'hak', en: 'tax relief for OKU and their families', ms: 'pelepasan cukai untuk OKU dan keluarga' },\n];\n\nconst start = new Date(Date.UTC(new Date().getUTCFullYear(), 0, 1));\nconst week = Math.floor((Date.now() - start) / (7 * 86400000));\nconst pick = SCHEMES[week % SCHEMES.length];\nconst langs = [...new Set(subs.map((s) => (s.lang === 'en' ? 'en' : 'ms')))];\n\nreturn langs.map((lang) => ({\n  json: {\n    lang,\n    topic: pick.topic,\n    scheme: pick[lang],\n    session_id: `digest-${start.getUTCFullYear()}-w${week}-${lang}`,\n    question: lang === 'en'\n      ? `Write a short weekly spotlight about ${pick.en} for OKU and their caregivers: what it is, who can get it, and how to apply. Use at most 120 words and short bullet points.`\n      : `Tulis sorotan mingguan yang ringkas tentang ${pick.ms} untuk OKU dan penjaga: apa itu, siapa yang layak, dan cara memohon. Gunakan paling banyak 120 patah perkataan dan poin ringkas.`,\n  },\n}));\n"
      },
